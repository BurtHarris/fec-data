{
  "name": "fec-data-dev",
  "dockerFile": "Dockerfile",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // --- Persistent storage volumes ---
  "mounts": [
    "source=fec_data,target=/workspaces/fec-data/data,type=volume",
    "source=fec_db,target=/workspaces/fec-data/db,type=volume"
  ],

  // --- Environment variables (critical) ---
  "containerEnv": {
    "FEC_DATA_DIR": "/workspaces/fec-data/data",
    "FEC_DB_DIR": "/workspaces/fec-data/db"
  },

  // --- VS Code extensions ---
  "customizations": {
    "vscode": {
      "extensions": [
        "galbezalel.vscode-duckdb-notebook",
        "chuckjonas.duckdb",
        "yy0931.vscode-sqlite3-editor",
        "ms-vscode.live-server",
        "ritwickdey.liveserver",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  // --- Docker-in-Docker support ---
  "runArgs": [
    "--init",
    "--privileged"
  ],

  "remoteUser": "astro"
}
