{
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.parquet": "duckdb.parquetViewer",
        "*.csv": "duckdb.csvViewer",
        "*.tsv": "duckdb.csvViewer"
    },
    "terminal.integrated.env.windows": {
        "PATH": "${workspaceFolder}/scripts;${env:PATH}"
    },
    "duckdb.databases": [
        {
            "alias": "fec",
            "type": "file",
            "path": "${workspaceFolder}/db/fec.duckdb",
            "readOnly": true,
            "attached": false
        }
    ],
    "duckdb.defaultDatabase": "fec",
    "chat.tools.terminal.autoApprove": {
        "/^uv run dbt test --profiles-dir \\. --vars \"\\{cycle: 2026\\}\" --select raw_fec$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}