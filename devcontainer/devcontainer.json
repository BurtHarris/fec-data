# This devcontainer/ path is kept only as a transitional copy.
# The active VS Code Dev Container configuration lives in .devcontainer/devcontainer.json.
# Keep the two in sync if this file remains temporarily.
{
  "name": "fec-data-dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "initializeCommand": "bash .devcontainer/scripts/init-host-paths.sh",
  "mounts": [
    "source=${localEnv:HOME}/.local/share/fec-data/data,target=/workspaces/fec-data/data,type=bind",
    "source=${localEnv:HOME}/.local/share/fec-data/db,target=/workspaces/fec-data/db,type=bind"
  ],
  "remoteEnv": {
    "FEC_DATA_DIR": "/workspaces/fec-data/data",
    "FEC_DB_DIR": "/workspaces/fec-data/db"
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "username": "vscode",
      "upgradePackages": true
    }
  },
  "postCreateCommand": "bash scripts/setup-tools.sh || true",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "charliermarsh.ruff"
      ]
    }
  }
}
