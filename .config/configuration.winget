# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Python311
      directives:
        description: Install Python 3.11 runtime for local ETL CLI tools
      settings:
        id: Python.Python.3.11
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Uv
      directives:
        description: Install uv for Python environment and command execution
      settings:
        id: Astral-sh.uv
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: DuckDBCli
      directives:
        description: Install DuckDB CLI for local analytics and ETL SQL
      settings:
        id: DuckDB.cli
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: GitForWindows
      directives:
        description: Install Git (includes Git Bash)
      settings:
        id: Git.Git
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Jq
      directives:
        description: Install jq for JSON parsing in shell pipelines
      settings:
        id: jqlang.jq
        source: winget
