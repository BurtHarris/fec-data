# FEC ETL local data and artifacts

# Keep ETL directory structure, but ignore actual data files
/data/raw/*
!/data/raw/.gitkeep
/data/staging/*
!/data/staging/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Exclude everything under data and db directories
/data/*
!/data/raw/.gitkeep
!/data/staging/.gitkeep
!/data/processed/.gitkeep
/db/*
!/db/.gitkeep

# Local DuckDB database artifacts
/db/*.duckdb
/db/*.db
/db/*.wal

# Logs and temp files
/logs/*
!/logs/.gitkeep
/tmp/*
!/tmp/.gitkeep

# Artifacts: commit living docs (exploration, diagrams, reviews, analysis)
# but ignore run-specific reports (regenerated per ETL run)
/artifacts/reports/*
!/artifacts/reports/.gitkeep

# Optional local environment files
.env
.env.*

# Node dependencies
node_modules/
