# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Python311
      directives:
        description: Install Python 3.11 runtime for local ETL CLI tools
      settings:
        id: Python.Python.3.11
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Uv
      directives:
        description: Install uv for Python environment and command execution
      settings:
        id: Astral-sh.uv
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: DuckDBCli
      directives:
        description: Install DuckDB CLI for local analytics and ETL SQL
      settings:
        id: DuckDB.cli
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: GitForWindows
      directives:
        description: Install Git (includes Git Bash)
      settings:
        id: Git.Git
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Jq
      directives:
        description: Install jq for JSON parsing in shell pipelines
      settings:
        id: jqlang.jq
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: SevenZip
      directives:
        description: Install 7-Zip for file extraction
      settings:
        id: 7zip.7zip
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Ripgrep
      directives:
        description: Install ripgrep for fast recursive search
      settings:
        id: BurntSushi.ripgrep.MSVC
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: GitHubCli
      directives:
        description: Install GitHub CLI for repository and PR workflows
      settings:
        id: GitHub.cli
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Fd
      directives:
        description: Install fd for fast file discovery
      settings:
        id: sharkdp.fd
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Fzf
      directives:
        description: Install fzf for interactive fuzzy finding
      settings:
        id: junegunn.fzf
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Bat
      directives:
        description: Install bat for syntax-highlighted file previews
      settings:
        id: sharkdp.bat
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: Delta
      directives:
        description: Install delta for improved git diff viewing
      settings:
        id: dandavison.delta
        source: winget
